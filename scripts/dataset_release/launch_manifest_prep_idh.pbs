#!/bin/bash
#PBS -N t2g_manifest_prep_idh
#PBS -P vp06
#PBS -q normal
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/vp06+gdata/hl36
#PBS -l jobfs=100GB
#PBS -l wd
#PBS -r y
#PBS -o /home/575/nk9793/job_logs/manifest_prep_idh.o
#PBS -e /home/575/nk9793/job_logs/manifest_prep_idh.e
#PBS -j n

# ----------------------------------------------------------------------
# Build the mask-first pre-generation manifest for the IDH-ONLY release.
#
# Same VASARI-auto → prompt pipeline as the vanilla launcher, but with
# --balance_mode=idh_only and CFG=4.5 (matches the manuscript deployment
# default; the earlier cfg=1.0 release produced synth-only classifier
# AUROC ≈ 0.5 because CFG=1 disables guidance and the single IDH token
# in a 128+1-token sequence has no path to influence pixel content).
#
# Output goes to a version-tagged release root
# (/g/data/vp06/$USER/text2glioma_synth_idh_only_cfg45) so the earlier
# cfg=1.0 release at .../text2glioma_synth_idh_only stays intact for
# apples-to-apples comparison.
#
# Submit:
#   qsub scripts/dataset_release/launch_manifest_prep_idh.pbs
#
# Override defaults (env-vars):
#   qsub -v CFG=7.0                  ...   # push guidance harder
#   qsub -v BALANCE_MODE=idh_only_natural ...
#
# CFG=7.0 pilot workflow (500 samples, single shard) — used to probe the
# CFG-vs-classifier-utility response curve without spending a full 10k
# generation budget:
#   qsub -v CFG=7.0,\
# T2G_N_SAMPLES=500,\
# T2G_NUM_SHARDS=1,\
# T2G_SYNTH_OUT=/g/data/vp06/$USER/text2glioma_synth_idh_only_cfg70_pilot \
#        scripts/dataset_release/launch_manifest_prep_idh.pbs
# ----------------------------------------------------------------------

set -euo pipefail

REPO=${TEXT2GLIOMA_REPO:-$HOME/text2glioma}
OUT_ROOT=${T2G_SYNTH_OUT:-/g/data/vp06/$USER/text2glioma_synth_idh_only_cfg45}
# Use the same N=1510 datalist as v1 for the mask pool — the mask
# geometry is orthogonal to molecular status, so we do NOT want to
# restrict the pool to the 494 IDH-known subjects (that would shrink
# anatomical diversity for no gain).
DATALIST=${T2G_DATALIST:-$REPO/datalist_N1510.json}

N_SAMPLES=${T2G_N_SAMPLES:-10000}
NUM_SHARDS=${T2G_NUM_SHARDS:-20}
SEED=${T2G_MANIFEST_SEED:-12345}
BALANCE_MODE=${BALANCE_MODE:-idh_only}
CFG=${CFG:-4.5}

module load python3/3.9.2
source /g/data/vp06/nk9793_hl36/venv/monai/bin/activate

cd "$REPO"
mkdir -p "$OUT_ROOT" "$OUT_ROOT/logs"

echo "===================================================================="
echo "Job:            $PBS_JOBID"
echo "Host:           $(hostname)"
echo "Started:        $(date -Iseconds)"
echo "Datalist:       $DATALIST"
echo "Out root:       $OUT_ROOT"
echo "N samples:      $N_SAMPLES"
echo "Num shards:     $NUM_SHARDS"
echo "Seed:           $SEED"
echo "BALANCE_MODE:   $BALANCE_MODE"
echo "CFG:            $CFG"
echo "PBS_JOBFS:      $PBS_JOBFS"
echo "===================================================================="

python scripts/dataset_release/prepare_manifest.py \
    --datalist "$DATALIST" \
    --split training \
    --n_samples "$N_SAMPLES" \
    --num_shards "$NUM_SHARDS" \
    --seed "$SEED" \
    --workers 16 \
    --tmp_dir "$PBS_JOBFS/t2g_manifest_tmp" \
    --out_root "$OUT_ROOT" \
    --out "$OUT_ROOT/manifest.csv" \
    --use_molecular \
    --balance_mode "$BALANCE_MODE" \
    --cfg "$CFG"

echo "manifest written to $OUT_ROOT/manifest.csv"
ls -lh "$OUT_ROOT/manifest.csv"
head -1 "$OUT_ROOT/manifest.csv"
wc -l "$OUT_ROOT/manifest.csv"

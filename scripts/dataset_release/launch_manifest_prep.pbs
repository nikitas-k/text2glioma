#!/bin/bash
#PBS -N t2g_manifest_prep
#PBS -P vp06
#PBS -q normal
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/vp06+gdata/hl36
#PBS -l jobfs=100GB
#PBS -l wd
#PBS -o /g/data/vp06/nk9793/text2glioma_synth/logs/manifest_prep.o
#PBS -e /g/data/vp06/nk9793/text2glioma_synth/logs/manifest_prep.e
#PBS -j n

# ----------------------------------------------------------------------
# Build the mask-first pre-generation manifest.
#
# For each of N samples:
#   1. sample a base training mask,
#   2. apply an affine deform (rot ±8°, trans ±6vox, scale ±8%),
#   3. run VASARI-auto on the deformed mask,
#   4. compose the impression prompt from the extracted features,
#   5. write a manifest row (mask path, deform params, prompt, ldm seed).
#
# CPU-bound, embarrassingly parallel — 16 workers on Gadi's `normal` queue.
# Temporary deformed masks are written to $PBS_JOBFS (local SSD) to avoid
# hammering /g/data.
#
# Submit:
#   qsub scripts/dataset_release/launch_manifest_prep.pbs
# ----------------------------------------------------------------------

set -euo pipefail

REPO=${TEXT2GLIOMA_REPO:-$HOME/text2glioma}
OUT_ROOT=${T2G_SYNTH_OUT:-/g/data/vp06/$USER/text2glioma_synth}
DATALIST=${T2G_DATALIST:-$REPO/datalist_N1510.json}

N_SAMPLES=${T2G_N_SAMPLES:-10000}
NUM_SHARDS=${T2G_NUM_SHARDS:-20}
SEED=${T2G_MANIFEST_SEED:-12345}

module load python3/3.11 2>/dev/null || true

if [[ -f "$REPO/.venv/bin/activate" ]]; then
    # shellcheck disable=SC1091
    source "$REPO/.venv/bin/activate"
elif [[ -f "$HOME/venv/monai/bin/activate" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/venv/monai/bin/activate"
fi

cd "$REPO"
export PYTHONPATH="$REPO/src:$PYTHONPATH"
mkdir -p "$OUT_ROOT" logs

echo "===================================================================="
echo "Job:            $PBS_JOBID"
echo "Host:           $(hostname)"
echo "Started:        $(date -Iseconds)"
echo "Datalist:       $DATALIST"
echo "Out root:       $OUT_ROOT"
echo "N samples:      $N_SAMPLES"
echo "Num shards:     $NUM_SHARDS"
echo "Seed:           $SEED"
echo "PBS_JOBFS:      $PBS_JOBFS"
echo "===================================================================="

python scripts/dataset_release/prepare_manifest.py \
    --datalist "$DATALIST" \
    --split training \
    --n_samples "$N_SAMPLES" \
    --num_shards "$NUM_SHARDS" \
    --seed "$SEED" \
    --workers 16 \
    --tmp_dir "$PBS_JOBFS/t2g_manifest_tmp" \
    --out "$OUT_ROOT/manifest.csv"

echo "manifest written to $OUT_ROOT/manifest.csv"
ls -lh "$OUT_ROOT/manifest.csv"
head -1 "$OUT_ROOT/manifest.csv"
wc -l "$OUT_ROOT/manifest.csv"

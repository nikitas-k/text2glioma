#!/bin/bash
#PBS -N t2g_synth_audit
#PBS -P vp06
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=128GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/vp06+gdata/hl36
#PBS -l wd
#PBS -r y
#PBS -J 0-19
#PBS -o /g/data/vp06/nk9793/text2glioma_synth/logs/synth_audit_^array_index^.o
#PBS -e /g/data/vp06/nk9793/text2glioma_synth/logs/synth_audit_^array_index^.e
#PBS -j n

# ----------------------------------------------------------------------
# Text2Glioma synthetic release: memorisation audit (Dar 2024 NN-SSIM).
#
# For each synthetic sample, compute the maximum per-modality SSIM
# against all 1,187 training images. Samples with NN-SSIM > 0.90 on any
# modality are flagged as potential memorisation.
#
# The audit is embarrassingly parallel across synthetic samples. Each
# array subjob handles 1/NUM_SHARDS of the total (hash-split by index).
# With batched SSIM (chunk_size=32, fp16 bank), per-sample cost is ~15s
# on a V100 → 500 samples/shard ≈ 2 h → 8 h walltime is a comfortable
# safety margin.
#
# Submit as two halves (gpuvolta caps array size ≤ 10 per submission):
#   qsub -J 0-9  scripts/dataset_release/launch_memorisation_audit.pbs
#   qsub -J 10-19 scripts/dataset_release/launch_memorisation_audit.pbs
#
# Each shard writes its own CSV to $OUT_ROOT/audit/audit_shard_XX.csv;
# after all shards finish, concatenate them and feed to
# build_release_manifest.py.
# ----------------------------------------------------------------------

set -euo pipefail

# ---- Paths (edit as needed) ------------------------------------------
REPO=${TEXT2GLIOMA_REPO:-$HOME/text2glioma}
OUT_ROOT=${T2G_SYNTH_OUT:-/g/data/vp06/$USER/text2glioma_synth}
DATALIST=${T2G_DATALIST:-$REPO/datalist_N1510.json}
NUM_SHARDS=${T2G_AUDIT_NUM_SHARDS:-20}

# ---- Environment (matches launch_gadi_array.pbs) ---------------------
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

cd "$REPO"
export HF_HOME=/g/data/vp06/nk9793/text2glioma_train/runs/cache/huggingface
export TRANSFORMERS_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$OUT_ROOT/audit" "$OUT_ROOT/logs"

# ---- Diagnostics -----------------------------------------------------
echo "===================================================================="
echo "Job:            $PBS_JOBID  (array=$PBS_ARRAY_INDEX)"
echo "Host:           $(hostname)"
echo "Started:        $(date -Iseconds)"
echo "Synth root:     $OUT_ROOT"
echo "Datalist:       $DATALIST"
echo "This shard:     $PBS_ARRAY_INDEX / $NUM_SHARDS"
nvidia-smi || true
echo "===================================================================="

# ---- Run --------------------------------------------------------------
python -u scripts/dataset_release/memorisation_audit.py \
    --synth_root "$OUT_ROOT" \
    --datalist   "$DATALIST" \
    --split      training \
    --shard      "$PBS_ARRAY_INDEX" \
    --num_shards "$NUM_SHARDS" \
    --chunk_size 32 \
    --half \
    --out        "$OUT_ROOT/audit/audit_shard_$(printf '%02d' $PBS_ARRAY_INDEX).csv" \
    --device     cuda

echo "===================================================================="
echo "Finished:       $(date -Iseconds)"
echo "===================================================================="

#!/bin/bash
#PBS -N t2g_synth_gen
#PBS -P vp06
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/vp06+gdata/hl36+gdata/dp63
#PBS -l wd
#PBS -J 0-19
#PBS -o /g/data/vp06/nk9793/text2glioma_synth/logs/synth_gen_^array_index^.o
#PBS -e /g/data/vp06/nk9793/text2glioma_synth/logs/synth_gen_^array_index^.e
#PBS -j n

# ----------------------------------------------------------------------
# Text2Glioma synthetic release: per-shard generation (10k samples,
# 20 shards, ~500 samples/shard, ~2 min/sample = ~16 h wall time worst
# case; usually 4-8 h per shard on a V100).
#
# Submit with:
#   qsub scripts/dataset_release/launch_gadi_array.pbs
#
# All 20 shards will run in parallel (subject to queue capacity). Each
# shard writes to its own subdirectory under $OUT_ROOT and can be
# resumed independently: re-running the same array job will skip
# already-completed samples.
#
# Prereqs before submission:
#   * scripts/dataset_release/prepare_manifest.py has been run to
#     produce $MANIFEST
#   * The MaxFeat checkpoint is present at $STAGE2_CKPT
#   * The .venv (with text2glioma installed in editable mode) is
#     activated in the environment (or use the module load below).
# ----------------------------------------------------------------------

set -euo pipefail

# ---- Paths (edit as needed) ------------------------------------------
REPO=${TEXT2GLIOMA_REPO:-$HOME/text2glioma}
RUNS_ROOT=${TEXT2GLIOMA_RUNS:-/g/data/vp06/$USER/text2glioma_train/runs}
OUT_ROOT=${T2G_SYNTH_OUT:-/g/data/vp06/$USER/text2glioma_release/synth_10k}
MANIFEST=${T2G_SYNTH_MANIFEST:-$OUT_ROOT/manifest.csv}

STAGE1_CONFIG="$REPO/configs/stage1.yaml"
STAGE2_CONFIG="$REPO/configs/ldm_radbert.yaml"
STAGE1_CKPT="$RUNS_ROOT/stage1_kl1e6_freebits_lc6/autoencoder_stage1/checkpoint.pth"
STAGE2_CKPT="$RUNS_ROOT/stage1_kl1e6_freebits_lc6/ldm_stage2/best_model.pth"

# ---- Environment -----------------------------------------------------
module load cuda/12.3.2 2>/dev/null || true
module load python3/3.11 2>/dev/null || true

# Prefer venv; fall back to system Python if not present.
if [[ -f "$REPO/.venv/bin/activate" ]]; then
    # shellcheck disable=SC1091
    source "$REPO/.venv/bin/activate"
elif [[ -f "$HOME/venv/monai/bin/activate" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/venv/monai/bin/activate"
fi

cd "$REPO"
export PYTHONPATH="$REPO/src:${PYTHONPATH:-}"
export HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}
export TRANSFORMERS_OFFLINE=1     # RadBERT already cached; keep runs offline
mkdir -p "$OUT_ROOT" logs

# ---- Diagnostics -----------------------------------------------------
echo "===================================================================="
echo "Job:            $PBS_JOBID  (array=$PBS_ARRAY_INDEX)"
echo "Host:           $(hostname)"
echo "Started:        $(date -Iseconds)"
echo "Manifest:       $MANIFEST"
echo "Out root:       $OUT_ROOT"
echo "Shard:          $PBS_ARRAY_INDEX"
echo "Stage-2 ckpt:   $STAGE2_CKPT"
nvidia-smi || true
echo "===================================================================="

# ---- Run --------------------------------------------------------------
python -u scripts/dataset_release/generate_dataset.py \
    --manifest      "$MANIFEST" \
    --shard         "$PBS_ARRAY_INDEX" \
    --out_root      "$OUT_ROOT" \
    --stage1_config "$STAGE1_CONFIG" \
    --stage2_config "$STAGE2_CONFIG" \
    --stage1_ckpt   "$STAGE1_CKPT" \
    --stage2_ckpt   "$STAGE2_CKPT" \
    --device        cuda \
    --steps         50

echo "===================================================================="
echo "Finished:       $(date -Iseconds)"
echo "===================================================================="

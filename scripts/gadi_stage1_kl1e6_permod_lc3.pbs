#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=48:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N stg1_permod0
#
# Per-modality MaxFeat WITHOUT free bits. Companion to
# gadi_stage1_kl1e6_freebits_permod_lc3.pbs — comparing the two isolates
# the marginal effect of free bits under the per-modality architecture,
# just as the joint-encoding lc=3/lc=3+FB pair does for that axis.
#
# Together with the four joint-encoding runs, this completes a full
# 2x3 design: {joint, per-modality} x {lc=6 no-FB, lc=6+FB, lc=3 no-FB,
# lc=3+FB} — modulo the per-modality axis fixing lc=3 by construction
# (Pinaya's original shape). Effective matrix:
#
#            free_bits=0                       free_bits=0.05
#   joint    stage1_overfit_ablate_kl1e6       stage1_kl1e6_freebits_lc6
#            stage1_kl1e6_lc3                  stage1_kl1e6_freebits_lc3
#   per-mod  stage1_kl1e6_permod_lc3 (this)    stage1_kl1e6_freebits_permod_lc3

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/stage1.yaml
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
DATALIST=${HOME}/text2glioma/datalist_N1510.json

export TORCH_HOME=${RUN_DIR}/cache
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$RUN_DIR" "$DATA_DIR" "${HOME}/job_logs" "$TORCH_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage1_ddp.py \
    --config "$CONFIG" \
    --run_dir "$RUN_DIR" \
    --run_name stage1_kl1e6_permod_lc3 \
    --datalist "$DATALIST" \
    --no_channel_reorder \
    --batch_size 2 \
    --num_epochs 1500 \
    --val_interval 10 \
    --no_augment \
    --pin_memory \
    --set model.kl_weight=1e-6 \
          model.params.in_channels=1 \
          model.params.out_channels=1 \
          model.params.latent_channels=3 \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_stage1_kl1e6_permod_lc3.log"

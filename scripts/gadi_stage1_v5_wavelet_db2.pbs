#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=48:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N v5_wav_db2

# ── v5: wavelet L1 loss (Daubechies-2) ──────────────────────────────
# Same as v5_wavelet_haar but uses db2 wavelet for better frequency
# localization (4-tap filter vs Haar's 2-tap).
#
# This run: adv_weight=0.1, r1_gamma=10.0, pw=1.0, adaptive_adv=true,
#           wavelet_loss_weight=1.0, wavelet_detail_weight=2.0, wavelet=db2

# ── Environment ─────────────────────────────────────────────────────
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

# ── Paths ───────────────────────────────────────────────────────────
CONFIG=${HOME}/text2glioma/configs/stage1.yaml
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
DATALIST=${HOME}/text2glioma/datalist_N1510.json  # Optional custom datalist (overrides data_dir)

# ── Pre-flight ──────────────────────────────────────────────────────
export TORCH_HOME=${RUN_DIR}/cache
mkdir -p "$RUN_DIR" "$DATA_DIR" "${HOME}/job_logs" "$TORCH_HOME"

if [ -z "$DATALIST" ]; then
    if [ ! -d "${DATA_DIR}/Task01_BrainTumour" ]; then
        echo "ERROR: BraTS dataset not found at ${DATA_DIR}/Task01_BrainTumour"
        echo "Download it on a login node first (see gadi_stage1.pbs comments)."
        exit 1
    fi
    EXTRA_ARGS="--data_dir $DATA_DIR"
else
    if [ ! -f "$DATALIST" ]; then
        echo "ERROR: Datalist not found at ${DATALIST}"
        exit 1
    fi
    EXTRA_ARGS="--datalist $DATALIST --no_channel_reorder"
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage1_ddp.py \
    --config  "$CONFIG" \
    --run_dir "$RUN_DIR" \
    --run_name v5_wavelet_db2 \
    $EXTRA_ARGS \
    --batch_size 4 \
    --num_epochs 500 \
    --val_interval 5 \
    --pin_memory \
    --set model.adaptive_adv_weight=true \
         model.adv_weight=0.1 \
         model.r1_gamma=10.0 \
         model.perceptual_weight=1.0 \
         model.wavelet_loss_weight=1.0 \
         model.wavelet_detail_weight=2.0 \
         model.wavelet_name=db2 \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}.log"

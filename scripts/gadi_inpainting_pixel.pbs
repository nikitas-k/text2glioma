#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=24:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N inpaint_pixel

# Pixel-space inpainting DDM (Paper B baseline against the LDM in
# scripts/gadi_inpainting_kl1e6.pbs). Same dataset, same conditioning,
# same noise schedule + v-prediction. The ONLY difference is no Stage-1 VAE:
# the UNet operates directly on 160×224×160 images.
#
# Memory budget at native spatial size (160, 224, 160), batch_size 1/rank,
# num_channels [64, 128, 192, 256], bf16 autocast: ~45-55 GB peak on H100.
# Per-rank batch_size 1 is the safe default; if a run shows lots of spare
# memory after the first val round you can bump to 2 and resume.
#
# Output dir lives alongside the LDM run for the same dataset/seed.

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/inpainting_pixel.yaml
DATALIST=${HOME}/text2glioma/datalist_brats_gli_2025_pairs_split.json
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs/stage1_overfit_ablate_kl1e6/inpainting_pixel

export TORCH_HOME=/g/data/vp06/$USER/text2glioma_train/runs/cache
export HF_HOME=$TORCH_HOME/huggingface
mkdir -p "$RUN_DIR" "${HOME}/job_logs" "$TORCH_HOME" "$HF_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

# Sanity-check that the first training image_a resolves to a real file so
# we fail fast if the dataset has moved (same check as the LDM launcher).
FIRST_IMG=$(python -c "import json; d=json.load(open('${DATALIST}')); print(d['training'][0]['image_a'][0])")
if [ ! -f "$FIRST_IMG" ]; then
    echo "ERROR: First training image_a not found: ${FIRST_IMG}"
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_pixel_inpainting_ddp.py \
    --config "$CONFIG" \
    --datalist "$DATALIST" \
    --run_dir "$RUN_DIR" \
    --batch_size 1 \
    --num_workers 4 \
    --pin_memory \
    --num_epochs 1000 \
    --val_interval 5 \
    --dilation_mm 18.0 \
    --balance_mode uniform \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_inpaint_pixel.log"

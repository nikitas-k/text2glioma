#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=48:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe

# ── Environment ─────────────────────────────────────────────────────
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

# ── Paths (edit these) ──────────────────────────────────────────────
CONFIG=${HOME}/text2glioma/configs/stage1.yaml
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data

# ── Option A: DecathlonDataset (BraTS MSD) ──────────────────────────
# Gadi compute nodes have NO internet access.  Download BraTS once on
# a login node BEFORE submitting this job:
#
#   source /g/data/hl36/nk9793/venv/monai/bin/activate
#   python -c "from monai.apps import DecathlonDataset; \
#     DecathlonDataset('${DATA_DIR}', 'Task01_BrainTumour', download=True, section='training')"
#
# Also pre-cache the MedicalNet perceptual-loss weights (torch.hub):
#
#   TORCH_HOME=${RUN_DIR}/cache python -c \
#     "import torch; torch.hub.load('Warvito/MedicalNet-models', \
#      model='medicalnet_resnet50_23datasets', verbose=True)"
#
# Pre-cache the text encoder (SD 2.1 CLIP *or* RadBERT) — pick one:
#
#   # SD 2.1 CLIP (default ldm.yaml):
#   python -c "from transformers import AutoTokenizer, CLIPTextModel; \
#     AutoTokenizer.from_pretrained('stabilityai/stable-diffusion-2-1-base', subfolder='tokenizer'); \
#     CLIPTextModel.from_pretrained('stabilityai/stable-diffusion-2-1-base', subfolder='text_encoder')"
#
#   # RadBERT (ldm_radbert.yaml):
#   python -c "from transformers import AutoTokenizer, AutoModel; \
#     AutoTokenizer.from_pretrained('StanfordAIMI/RadBERT'); \
#     AutoModel.from_pretrained('StanfordAIMI/RadBERT')"
#
# ── Option B: Custom datalist (JSON) ────────────────────────────────
# Generate a datalist from your own NIfTIs:
#   python scripts/make_datalist.py \
#       --images '/g/data/hl36/mhf/monai/Task03_BrainTumourDx/imagesTr/nnUNetv2-*_full.nii' \
#       --labels '/g/data/hl36/mhf/monai/Task03_BrainTumourDx/labelsTr/nnUNetv2-*.nii.gz' \
#       -o datalist.json
# Then set DATALIST below and uncomment "--datalist" / "--no_channel_reorder".
DATALIST=""  # e.g. ${HOME}/text2glioma/datalist.json

# ── Pre-flight ──────────────────────────────────────────────────────
export TORCH_HOME=${RUN_DIR}/cache
mkdir -p "$RUN_DIR" "$DATA_DIR" "${HOME}/job_logs" "$TORCH_HOME"

if [ -z "$DATALIST" ]; then
    # Using DecathlonDataset — verify it exists
    if [ ! -d "${DATA_DIR}/Task01_BrainTumour" ]; then
        echo "ERROR: BraTS dataset not found at ${DATA_DIR}/Task01_BrainTumour"
        echo "Download it on a login node first (see comments in this script)."
        exit 1
    fi
    EXTRA_ARGS="--data_dir $DATA_DIR"
else
    # Using custom datalist
    if [ ! -f "$DATALIST" ]; then
        echo "ERROR: Datalist not found at ${DATALIST}"
        exit 1
    fi
    EXTRA_ARGS="--datalist $DATALIST --no_channel_reorder"
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage1_ddp.py \
    --config  "$CONFIG" \
    --run_dir "$RUN_DIR" \
    $EXTRA_ARGS \
    --batch_size 4 \
    --num_epochs 500 \
    --val_interval 5 \
    --pin_memory \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}.log"

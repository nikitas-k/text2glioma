#!/bin/bash

#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l jobfs=100GB
#PBS -q gpuvolta
#PBS -P vp06
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/vp06+gdata/hl36
#PBS -l wd
#PBS -j oe
#PBS -r y
#PBS -J 0-29
#PBS -o /g/data/vp06/nk9793/text2glioma_classify/logs/^array_index^.o
#PBS -e /g/data/vp06/nk9793/text2glioma_classify/logs/^array_index^.e
#PBS -N cls_grid

# ---------------------------------------------------------------------
# Downstream classifier grid: real+synth augmentation sweep.
#
# Grid: 2 tasks × 5 synthetic sizes × 3 seeds = 30 runs (indices 0..29)
#
#   task ∈ {idh, mgmt}
#   n_synthetic ∈ {0, 100, 1000, 5000, 10000}
#   seed ∈ {0, 1, 2}
#
# Array index i decomposes as: i = task*15 + n_idx*3 + seed
#
# Submit:
#   qsub -J 0-14  scripts/gadi_classifier_grid.pbs
#   qsub -J 15-29 scripts/gadi_classifier_grid.pbs
# (gpuvolta caps user array sizes ≤ 10-15 per submission)
# ---------------------------------------------------------------------

set -euo pipefail

# ---- Grid decode -----------------------------------------------------
TASKS=(idh mgmt)
N_SYNTH_LIST=(0 100 1000 5000 10000)
SEEDS=(0 1 2)

I=${PBS_ARRAY_INDEX}
TASK_IDX=$(( I / 15 ))
REM=$(( I % 15 ))
N_IDX=$(( REM / 3 ))
SEED_IDX=$(( REM % 3 ))

TASK=${TASKS[$TASK_IDX]}
N_SYNTH=${N_SYNTH_LIST[$N_IDX]}
SEED=${SEEDS[$SEED_IDX]}

# ---- Paths ------------------------------------------------------------
REPO=${TEXT2GLIOMA_REPO:-$HOME/text2glioma}
DATALIST=${T2G_MOLECULAR_DATALIST:-$REPO/datalist_N494_molecular.json}
SYNTH_ROOT=${T2G_SYNTH_OUT:-/g/data/vp06/$USER/text2glioma_synth}
OUT_ROOT=${T2G_CLS_OUT:-/g/data/vp06/$USER/text2glioma_classify}

RUN_DIR=$OUT_ROOT/${TASK}/n_synth_${N_SYNTH}/seed_${SEED}

# ---- Environment (matches Gadi generation launcher) ------------------
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

cd "$REPO"
export HF_HOME=/g/data/vp06/$USER/text2glioma_train/runs/cache/huggingface
export TRANSFORMERS_OFFLINE=1
mkdir -p "$OUT_ROOT/logs" "$RUN_DIR"

# ---- Diagnostics -----------------------------------------------------
echo "===================================================================="
echo "Job:      $PBS_JOBID  (array=$PBS_ARRAY_INDEX)"
echo "Host:     $(hostname)"
echo "Started:  $(date -Iseconds)"
echo "Task:     $TASK    n_synth: $N_SYNTH    seed: $SEED"
echo "Datalist: $DATALIST"
echo "Synth:    $SYNTH_ROOT"
echo "Out:      $RUN_DIR"
nvidia-smi || true
echo "===================================================================="

# ---- Run --------------------------------------------------------------
python -u scripts/train_molecular_classifier.py \
    --task           "$TASK" \
    --real_datalist  "$DATALIST" \
    --synth_root     "$SYNTH_ROOT" \
    --n_synthetic    "$N_SYNTH" \
    --seed           "$SEED" \
    --n_epochs       200 \
    --batch_size     8 \
    --val_batch_size 8 \
    --num_workers    8 \
    --val_interval   5 \
    --out_dir        "$RUN_DIR" \
    --device         cuda

echo "===================================================================="
echo "Finished: $(date -Iseconds)"
echo "===================================================================="

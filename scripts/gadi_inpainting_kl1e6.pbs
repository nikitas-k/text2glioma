#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=24:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N inpaint_kl1e6

# Inpainting LDM on top of the kl=1e-6 over-fitted Stage-1 VAE.
#
# Trains on BraTS-GLI 2025 longitudinal pairs (Paper B).
# Categorical-only conditioning: trajectory + treatment_a + treatment_b.
# No text encoder; no overlap with the N1510 cohort.
#
# Channel handling
#   Stage-1 (kl1e6) has latent_channels=6. train_inpainting_ddp.py probes the
#   Stage-1 with one batch at startup and rewrites the UNet config to
#       in_channels  = 2*6 + 1 = 13
#       out_channels = 6
#   The YAML defaults are placeholders; the runtime values win.
#
# scale_factor
#   Auto-computed from 50 training batches at startup (1 / std(stage1(image_b))).
#   Required for the kl1e6 latent space which has std >> 1; using 1.0 would
#   miscalibrate the noise schedule (see /memories/repo: "LDM training" note).
#
# Output dir
#   Lives alongside the Stage-2 LDM run for the same Stage-1, in a sibling
#   subfolder `inpainting_ldm` (vs `ldm_stage2` / `ldm_stage2_ckpt`).
#
# Datalist
#   datalist_brats_gli_2025_pairs_split.json: 704 train / 90 val / 95 test
#   pairs, subject-stratified by treatment-direction + trajectory.

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/inpainting.yaml
STAGE1_CONFIG=${HOME}/text2glioma/configs/stage1.yaml
# Stage-1 hit early stopping, so we use the last-saved checkpoint.pth (which
# also wraps EMA / discriminator). get_model + from_file handles both
# checkpoint.pth (wrapped dict) and final_model.pth (raw state_dict) via
# _extract_state_dict_from_checkpoint + _normalise_autoencoder_state_dict.
STAGE1_URI=/g/data/vp06/$USER/text2glioma_train/runs/stage1_overfit_ablate_kl1e6/autoencoder_stage1/checkpoint.pth
DATALIST=${HOME}/text2glioma/datalist_brats_gli_2025_pairs_split.json
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs/stage1_overfit_ablate_kl1e6/inpainting_ldm

export TORCH_HOME=/g/data/vp06/$USER/text2glioma_train/runs/cache
export HF_HOME=$TORCH_HOME/huggingface
mkdir -p "$RUN_DIR" "${HOME}/job_logs" "$TORCH_HOME" "$HF_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

if [ ! -f "${STAGE1_URI}" ]; then
    echo "ERROR: Stage-1 checkpoint not found at ${STAGE1_URI}"
    echo "Expected the Stage-1 early-stop checkpoint.pth from"
    echo "stage1_overfit_ablate_kl1e6/autoencoder_stage1/."
    exit 1
fi

# BraTS-GLI dataset paths in the datalist are absolute and live under
# /g/data/vp06/${USER}/monai/DataSet/BraTS2025-GLI-PRE-POST/. Sanity-check
# that the first image_a tuple resolves to a real file so we fail fast if
# the dataset has been moved.
FIRST_IMG=$(python -c "import json; d=json.load(open('${DATALIST}')); print(d['training'][0]['image_a'][0])")
if [ ! -f "$FIRST_IMG" ]; then
    echo "ERROR: First training image_a not found: ${FIRST_IMG}"
    echo "Check the dataset_root used by scripts/build_brats_gli_pairs.py."
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_inpainting_ddp.py \
    --config "$CONFIG" \
    --stage1_config "$STAGE1_CONFIG" \
    --stage1_uri "$STAGE1_URI" \
    --datalist "$DATALIST" \
    --run_dir "$RUN_DIR" \
    --batch_size 4 \
    --num_workers 4 \
    --pin_memory \
    --num_epochs 1000 \
    --val_interval 5 \
    --dilation_mm 18.0 \
    --balance_mode uniform \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_inpaint_kl1e6.log"

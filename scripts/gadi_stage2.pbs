#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=48:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe

# ── Environment ─────────────────────────────────────────────────────
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

# ── Paths (edit these) ──────────────────────────────────────────────
# For RadBERT, change CONFIG to configs/ldm_radbert.yaml
CONFIG=${HOME}/text2glioma/configs/ldm.yaml
STAGE1_CONFIG=${HOME}/text2glioma/configs/stage1.yaml
STAGE1_URI=/g/data/vp06/$USER/text2glioma_train/runs/text2glioma/autoencoder_stage1/output/models/best_model.pth
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data

# ── Option B: Custom datalist (set to path, or leave empty for DecathlonDataset)
DATALIST=""  # e.g. ${HOME}/text2glioma/datalist_task03.json

# ── Pre-flight ──────────────────────────────────────────────────────
export TORCH_HOME=${RUN_DIR}/cache
export HF_HOME=${RUN_DIR}/cache/huggingface
mkdir -p "$RUN_DIR" "$DATA_DIR" "${HOME}/job_logs" "$TORCH_HOME" "$HF_HOME"

if [ -z "$DATALIST" ]; then
    if [ ! -d "${DATA_DIR}/Task01_BrainTumour" ]; then
        echo "ERROR: BraTS dataset not found at ${DATA_DIR}/Task01_BrainTumour"
        echo "Download it on a login node first (see gadi_stage1.pbs comments)."
        exit 1
    fi
    EXTRA_ARGS="--data_dir $DATA_DIR"
else
    if [ ! -f "$DATALIST" ]; then
        echo "ERROR: Datalist not found at ${DATALIST}"
        exit 1
    fi
    EXTRA_ARGS="--datalist $DATALIST --no_channel_reorder"
fi

if [ ! -f "${STAGE1_URI}" ]; then
    echo "ERROR: Stage-1 checkpoint not found at ${STAGE1_URI}"
    echo "Train stage 1 first: qsub scripts/gadi_stage1.pbs"
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage2_ddp.py \
    --config       "$CONFIG" \
    --stage1_config "$STAGE1_CONFIG" \
    --stage1_uri   "$STAGE1_URI" \
    --run_dir      "$RUN_DIR" \
    $EXTRA_ARGS \
    --batch_size 2 \
    --num_epochs 1500 \
    --val_interval 10 \
    --pin_memory \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}.log"

#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=48:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N stg1_of_kl1e6_tw5

# Ablation G: recommended-recipe (kl=1e-6, attention on) + tumor-weighted L1.
#   model.tumor_weight = 5.0   →   per-voxel L1 inside tumor (label > 0)
#                                  is weighted 5x relative to non-tumor.
#   Loads the segmentation label alongside the image (carried through
#   every spatial transform with nearest-neighbour interpolation).
# Purpose: recover tumor-region high-frequency detail that was lost when
# the KL re-weighting (1e-10 → 1e-6) globally smoothed the reconstructions
# (see audit_figures/tumor_recon/ for the quantitative analysis showing
# tumor-region gradient-magnitude attenuation 1.69× vs 1.44× outside in T2).

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/stage1.yaml
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
DATALIST=${HOME}/text2glioma/datalist_N1510.json

export TORCH_HOME=${RUN_DIR}/cache
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$RUN_DIR" "$DATA_DIR" "${HOME}/job_logs" "$TORCH_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage1_ddp.py \
    --config "$CONFIG" \
    --run_dir "$RUN_DIR" \
    --run_name stage1_overfit_ablate_kl1e6_tumorw5 \
    --datalist "$DATALIST" \
    --no_channel_reorder \
    --batch_size 1 \
    --num_epochs 1500 \
    --val_interval 10 \
    --no_augment \
    --pin_memory \
    --set model.kl_weight=1e-6 \
          model.tumor_weight=5.0 \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_stage1_overfit_ablate_kl1e6_tumorw5.log"

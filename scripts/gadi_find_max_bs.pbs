#!/bin/bash

#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=256GB
#PBS -l jobfs=50GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=00:10:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N find_max_bs

# ── Find max LDM batch size per GPU ────────────────────────────────
# Runs a single training step at increasing batch sizes until OOM.
# Tests latent_channels = 3, 4, 8.

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

SCRIPT=${HOME}/text2glioma/scripts/find_max_bs_ldm.py
CACHE_DIR=/g/data/vp06/$USER/text2glioma_train/runs/cache
S1_CFG=${HOME}/text2glioma/configs/stage1.yaml

echo "===== CLIP (ldm.yaml) ====="
echo "--- latent_channels=3 (current) ---"
python $SCRIPT --stage1_config $S1_CFG --ldm_config ${HOME}/text2glioma/configs/ldm.yaml --latent_channels 3 --max_bs 16 --cache_dir $CACHE_DIR

echo ""
echo "--- latent_channels=4 ---"
python $SCRIPT --stage1_config $S1_CFG --ldm_config ${HOME}/text2glioma/configs/ldm.yaml --latent_channels 4 --max_bs 16 --cache_dir $CACHE_DIR

echo ""
echo "--- latent_channels=8 ---"
python $SCRIPT --stage1_config $S1_CFG --ldm_config ${HOME}/text2glioma/configs/ldm.yaml --latent_channels 8 --max_bs 16 --cache_dir $CACHE_DIR

echo ""
echo "===== RadBERT (ldm_radbert.yaml) ====="
echo "--- latent_channels=3 (current) ---"
python $SCRIPT --stage1_config $S1_CFG --ldm_config ${HOME}/text2glioma/configs/ldm_radbert.yaml --latent_channels 3 --max_bs 16 --cache_dir $CACHE_DIR

echo ""
echo "--- latent_channels=4 ---"
python $SCRIPT --stage1_config $S1_CFG --ldm_config ${HOME}/text2glioma/configs/ldm_radbert.yaml --latent_channels 4 --max_bs 16 --cache_dir $CACHE_DIR

echo ""
echo "--- latent_channels=8 ---"
python $SCRIPT --stage1_config $S1_CFG --ldm_config ${HOME}/text2glioma/configs/ldm_radbert.yaml --latent_channels 8 --max_bs 16 --cache_dir $CACHE_DIR

echo ""
echo "Done."

#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N pinaya_dec

# ── Pinaya VAE fine-tuning: DECODER ONLY ────────────────────────────
#
# Strategy: freeze the Pinaya encoder, fine-tune only the decoder.
# Each BraTS modality (T1, T1CE, T2, FLAIR) is processed as an
# independent 1-channel pass through the VAE.
#
# Estimated: ~50 epochs × ~297 batches/epoch (N=1187, 4 GPUs, bs=1)
#   4 channel passes per sample (gradient-checkpointed)
#   At ~60-90s/epoch on 4×H200 → ~50-75 min total.
#
# Logs: TensorBoard with L1, SSIM, MS-SSIM per-channel (same as v4+)

# ── Environment ─────────────────────────────────────────────────────
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

# ── Paths ───────────────────────────────────────────────────────────
CONFIG=${HOME}/text2glioma/configs/stage1_pinaya_decoder_only.yaml
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
DATALIST=${HOME}/text2glioma/datalist_N1510.json

# ── Pre-flight ──────────────────────────────────────────────────────
export TORCH_HOME=${RUN_DIR}/cache
export HF_HOME=${RUN_DIR}/cache/huggingface
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$RUN_DIR" "$DATA_DIR" "${HOME}/job_logs" "$TORCH_HOME"

# Download Pinaya weights on rank 0 before torchrun
PINAYA_WEIGHTS=${RUN_DIR}/cache/pinaya_autoencoder.pth
if [ ! -f "$PINAYA_WEIGHTS" ]; then
    echo "Downloading Pinaya VAE weights …"
    python -c "
import gdown, pathlib
pathlib.Path('${RUN_DIR}/cache').mkdir(parents=True, exist_ok=True)
gdown.download(
    'https://drive.google.com/uc?export=download&id=1CZHwxHJWybOsDavipD0EorDPOo_mzNeX',
    '${PINAYA_WEIGHTS}', quiet=False)
"
fi

# ── Launch ──────────────────────────────────────────────────────────
if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_pinaya_finetune.py \
    --config  "$CONFIG" \
    --run_dir "$RUN_DIR" \
    --run_name pinaya_decoder_only \
    --strategy decoder_only \
    --datalist "$DATALIST" --no_channel_reorder \
    --pinaya_weights "$PINAYA_WEIGHTS" \
    --cache_dir "${RUN_DIR}/cache" \
    --batch_size 1 \
    --num_epochs 50 \
    --val_interval 5 \
    --pin_memory \
    --find_unused_parameters \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}.log"

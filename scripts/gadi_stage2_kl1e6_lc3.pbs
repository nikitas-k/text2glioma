#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=24:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N ldm_lc3

# Stage-2 LDM on top of stage1_kl1e6_lc3 (kl_weight=1e-6, latent_channels=3,
# no free bits). Companion to gadi_stage2_kl1e6_freebits_lc3.pbs — comparing
# the two isolates the marginal effect of free bits at the lc=3 sweet-spot.

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/ldm_radbert.yaml
STAGE1_CONFIG=${HOME}/text2glioma/configs/stage1.yaml
STAGE1_URI=/g/data/vp06/$USER/text2glioma_train/runs/stage1_kl1e6_lc3/autoencoder_stage1/checkpoint.pth
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
STAGE2_RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs/stage1_kl1e6_lc3/ldm_stage2
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
DATALIST=${HOME}/text2glioma/datalist_N1510.json

export TORCH_HOME=${RUN_DIR}/cache
export HF_HOME=${RUN_DIR}/cache/huggingface
mkdir -p "$RUN_DIR" "$DATA_DIR" "$STAGE2_RUN_DIR" "${HOME}/job_logs" "$TORCH_HOME" "$HF_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

if [ ! -f "${STAGE1_URI}" ]; then
    echo "ERROR: Stage-1 checkpoint not found at ${STAGE1_URI}"
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage2_ddp.py \
    --config "$CONFIG" \
    --stage1_config "$STAGE1_CONFIG" \
    --stage1_uri "$STAGE1_URI" \
    --run_dir "$RUN_DIR" \
    --stage2_run_dir "$STAGE2_RUN_DIR" \
    --datalist "$DATALIST" \
    --no_channel_reorder \
    --train_spec impression \
    --text_dropout_p 0.35 \
    --mask_dropout_p 0.30 \
    --val_interval 5 \
    --batch_size 8 \
    --num_epochs 1000 \
    --pin_memory \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_ldm_lc3.log"
#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=48:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N ldm_lc3

# Stage-2 text+mask LDM on top of the 3-channel MaxFeat stage-1
# (`stage1_kl1e6_lc3`, kl_weight=1e-6, no free bits, latent_channels=3).
# Tests whether the channel-reduction axis alone (isolated from free
# bits) is sufficient to restore diffusion trainability — the §3.5
# 2x2 factorial completion.
#
# The `train_stage2_ddp.py` runtime auto-detects the stage-1 latent
# channel count via a forward-pass probe and adjusts the UNet
# in/out_channels accordingly, so the same ldm_radbert.yaml config
# used by the lc=6 baseline works here unchanged.

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/ldm_radbert.yaml
STAGE1_CONFIG=${HOME}/text2glioma/configs/stage1.yaml
STAGE1_URI=/g/data/vp06/$USER/text2glioma_train/runs/stage1_kl1e6_lc3/autoencoder_stage1/checkpoint.pth
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
STAGE2_RUN_DIR=${RUN_DIR}/stage1_kl1e6_lc3/ldm_stage2
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
DATALIST=${HOME}/text2glioma/datalist_N1510.json

export TORCH_HOME=${RUN_DIR}/cache
export HF_HOME=${RUN_DIR}/cache/huggingface
mkdir -p "$RUN_DIR" "$DATA_DIR" "$STAGE2_RUN_DIR" "${HOME}/job_logs" "$TORCH_HOME" "$HF_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

if [ ! -f "${STAGE1_URI}" ]; then
    echo "ERROR: Stage-1 checkpoint not found at ${STAGE1_URI}"
    echo "Wait for stage1_kl1e6_lc3 to finish, or point STAGE1_URI at final_model.pth."
    exit 1
fi

# Config-mismatch is expected: stage-1 has latent_channels=3, stage-2 yaml
# defaults to 4. train_stage2_ddp.py auto-aligns from the probe (see the
# [WARN] Stage-2 config/channel mismatch log line).

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage2_ddp.py \
    --config "$CONFIG" \
    --stage1_config "$STAGE1_CONFIG" \
    --stage1_uri "$STAGE1_URI" \
    --run_dir "$RUN_DIR" \
    --stage2_run_dir "$STAGE2_RUN_DIR" \
    --datalist "$DATALIST" \
    --no_channel_reorder \
    --train_spec impression \
    --text_dropout_p 0.35 \
    --mask_dropout_p 0.30 \
    --val_interval 5 \
    --batch_size 8 \
    --num_epochs 1000 \
    --pin_memory \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_ldm_lc3.log"

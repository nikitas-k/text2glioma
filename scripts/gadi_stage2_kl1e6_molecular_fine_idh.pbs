#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N ldm_molfine_idh

# ---------------------------------------------------------------------
# Stage-2 fine-tune with learnable IDH-ONLY class conditioning.
#
# Rationale:
#   The v1 IDH+MGMT head degraded downstream classifier accuracy
#   (MGMT 0.636 -> 0.499 at N=10k, IDH 0.856 -> 0.722). Analysis of
#   the two directions concluded that (a) MGMT (a promoter-methylation
#   biomarker) has no reliable anatomical MRI correlate, so the head
#   was fitting noise; and (b) including MGMT-cohort selection biases
#   contaminated the shared conditioning space, hurting IDH too.
#
#   This run drops MGMT entirely and retrains an IDH-only head. The
#   head has half the parameters (~2.3k) and can use the full N=494
#   IDH-known cohort (v1 was restricted to N=360 both-known, which
#   sacrificed 66% of IDH-mutant training samples).
#
# Setup:
#   * Warm-start from the pre-molecular v1 body (ldm_stage2/best_model.pth)
#     rather than from ldm_stage2_molecular. This gives the fresh IDH
#     head a clean starting point without absorbing the corrupted joint
#     representation.
#   * MolecularClassConditioning(fields=("idh",)): only idh_embedding
#     is allocated (2,304 params @ hidden_dim=768). Head LR = 10x base.
#   * Molecular dropout-to-unknown 0.20 (CFG null direction training).
#   * 25 epochs on 4x H100 fits comfortably in 12h walltime.
# ---------------------------------------------------------------------

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/ldm_radbert.yaml
STAGE1_CONFIG=${HOME}/text2glioma/configs/stage1.yaml
STAGE1_URI=/g/data/vp06/$USER/text2glioma_train/runs/stage1_kl1e6_freebits_lc6/autoencoder_stage1/checkpoint.pth
V1_STAGE2_CKPT=/g/data/vp06/$USER/text2glioma_train/runs/stage1_kl1e6_freebits_lc6/ldm_stage2/best_model.pth

RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
STAGE2_RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs/stage1_kl1e6_freebits_lc6/ldm_stage2_molecular_idh_only
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
# N=494 datalist: all subjects with IDH known (WT or MUT). No MGMT
# filtering, so the full IDH-mutant population is available for
# training (~104 mutants vs. only 35 in the both-known N=360 split).
DATALIST=${HOME}/text2glioma/datalist_N494_idh_only.json

export TORCH_HOME=${RUN_DIR}/cache
export HF_HOME=${RUN_DIR}/cache/huggingface
mkdir -p "$RUN_DIR" "$DATA_DIR" "$STAGE2_RUN_DIR" "${HOME}/job_logs" "$TORCH_HOME" "$HF_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi
if [ ! -f "${STAGE1_URI}" ]; then
    echo "ERROR: Stage-1 checkpoint not found at ${STAGE1_URI}"
    exit 1
fi
if [ ! -f "${V1_STAGE2_CKPT}" ]; then
    echo "ERROR: v1 stage-2 warm-start checkpoint not found at ${V1_STAGE2_CKPT}"
    exit 1
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage2_ddp.py \
    --config "$CONFIG" \
    --stage1_config "$STAGE1_CONFIG" \
    --stage1_uri "$STAGE1_URI" \
    --warm_start_stage2 "$V1_STAGE2_CKPT" \
    --run_dir "$RUN_DIR" \
    --stage2_run_dir "$STAGE2_RUN_DIR" \
    --datalist "$DATALIST" \
    --no_channel_reorder \
    --train_spec impression \
    --text_dropout_p 0.35 \
    --mask_dropout_p 0.30 \
    --joint_dropout_p 0.10 \
    --use_molecular_conditioning \
    --molecular_fields idh \
    --molecular_dropout_p 0.20 \
    --molecular_lr_multiplier 10.0 \
    --val_interval 2 \
    --batch_size 8 \
    --num_epochs 25 \
    --pin_memory \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_ldm_molfine_idh.log"

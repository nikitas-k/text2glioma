#!/bin/bash

#PBS -l ncpus=48
#PBS -l ngpus=4
#PBS -l mem=1022GB
#PBS -l jobfs=250GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=48:00:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N ldm_kl1e6_jd_scratch

# MaxFeat (kl=1e-6) stage-2 LDM, trained from scratch with joint-dropout.
# Companion to gadi_stage2_kl1e6_jointdrop.pbs (which resumes from the
# existing checkpoint). Together they test §3.5 hypothesis about the
# occipital-lesion attractor in the unconditional prior:
#
#   * resume variant tests: does more joint-uncond training rescue an
#     already-collapsed prior?
#   * scratch variant tests: with joint-dropout from step 0, does the
#     prior collapse to the same attractor, a different attractor, or a
#     properly-distributed healthy-brain prior?
#
# Both point at the same output DAG as `gadi_stage2_kl1e6_ckpt.pbs` (the
# canonical MaxFeat text-conditional stage-2 recipe) but with the new
# --joint_dropout_p 0.30 flag added and a separate run dir.
#
# Schedule
#   text_dropout=0.35, mask_dropout=0.30, independent -> P(both) = 0.105
#   joint_dropout_p=0.30 on top                       -> P(both) ~= 0.37
#
# Distinct from the resume variant, this run:
#   * does NOT set --warm_start_stage2
#   * uses a fresh 48h walltime budget for full training
#   * outputs to `ldm_stage2_jd_scratch/`

module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

CONFIG=${HOME}/text2glioma/configs/ldm_radbert.yaml
STAGE1_CONFIG=${HOME}/text2glioma/configs/stage1.yaml
STAGE1_URI=/g/data/vp06/$USER/text2glioma_train/runs/stage1_overfit_ablate_kl1e6/autoencoder_stage1/checkpoint.pth
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs
STAGE2_RUN_DIR=${RUN_DIR}/stage1_overfit_ablate_kl1e6/ldm_stage2_jd_scratch
DATA_DIR=/g/data/vp06/$USER/text2glioma_train/data
DATALIST=${HOME}/text2glioma/datalist_N1510.json

export TORCH_HOME=${RUN_DIR}/cache
export HF_HOME=${RUN_DIR}/cache/huggingface
mkdir -p "$RUN_DIR" "$DATA_DIR" "$STAGE2_RUN_DIR" "${HOME}/job_logs" "$TORCH_HOME" "$HF_HOME"

if [ ! -f "$DATALIST" ]; then
    echo "ERROR: Datalist not found at ${DATALIST}"
    exit 1
fi

if [ ! -f "${STAGE1_URI}" ]; then
    echo "ERROR: Stage-1 checkpoint not found at ${STAGE1_URI}"
    exit 1
fi

# Sanity-check the stage-1 checkpoint format (mirrors gadi_stage2_kl1e6_ckpt.pbs).
python - "$STAGE1_URI" <<'PY'
import sys, torch
path = sys.argv[1]
ckpt = torch.load(path, map_location="cpu", weights_only=False)
if not isinstance(ckpt, dict):
    print(f"[sanity] {path} is not a dict (got {type(ckpt).__name__})", file=sys.stderr)
    sys.exit(2)
keys = list(ckpt.keys())
print(f"[sanity] checkpoint top-level keys: {keys}")
sd_key = None
for k in ("state_dict", "model", "autoencoder", "vae"):
    if isinstance(ckpt.get(k), dict) and ckpt[k]:
        sd_key = k
        break
if sd_key is None and all(torch.is_tensor(v) for v in ckpt.values()):
    sd_key = "<root>"
if sd_key is None:
    print("[sanity] no usable state_dict key found", file=sys.stderr)
    sys.exit(3)
sd = ckpt if sd_key == "<root>" else ckpt[sd_key]
sample_keys = list(sd.keys())[:3]
print(f"[sanity] using key='{sd_key}' n_params={len(sd)} sample={sample_keys}")
if "epoch" in ckpt:
    print(f"[sanity] checkpoint epoch={ckpt['epoch']}")
PY
SANITY_RC=$?
if [ $SANITY_RC -ne 0 ]; then
    echo "ERROR: Stage-1 checkpoint sanity check failed (rc=${SANITY_RC})"
    exit $SANITY_RC
fi

torchrun --standalone --nproc_per_node=4 \
    ${HOME}/text2glioma/scripts/launch_stage2_ddp.py \
    --config "$CONFIG" \
    --stage1_config "$STAGE1_CONFIG" \
    --stage1_uri "$STAGE1_URI" \
    --run_dir "$RUN_DIR" \
    --stage2_run_dir "$STAGE2_RUN_DIR" \
    --datalist "$DATALIST" \
    --no_channel_reorder \
    --train_spec impression \
    --text_dropout_p 0.35 \
    --mask_dropout_p 0.30 \
    --joint_dropout_p 0.30 \
    --val_interval 5 \
    --batch_size 8 \
    --num_epochs 1000 \
    --pin_memory \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_ldm_kl1e6_jd_scratch.log"

#!/bin/bash
# Train five nnU-Net v2 3d_fullres models (real-only baseline + four synthetic-augmented
# doses). Array indices 0..4 map to n_synth in {0, 500, 1000, 5000, 10000}, i.e. Dataset510..514.
#
# Edit PROJ, USER, and NNUNET_ROOT to your Gadi paths before submitting:
#     qsub scripts/segmentation/gadi_nnunet_train.pbs
#
#PBS -q gpuhopper
#PBS -N t2g_nnunet_train
#PBS -P vp06
#PBS -J 0-4
#PBS -l ncpus=24
#PBS -l ngpus=1
#PBS -l mem=256GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/vp06+gdata/vp06+gdata/hl36
#PBS -l wd
#PBS -j oe

set -euo pipefail

# --- Gadi paths (edit) -----------------------------------------------------
PROJ="vp06"
USER_DIR="$HOME/mhf/projects/text2glioma"
NNUNET_ROOT="/g/data/${PROJ}/${USER}/nnUNet"
REAL_ROOT="/g/data/hl36/mhf/monai/Task03_BrainTumourDx/imagesTr"
SYNTH_MANIFEST="/g/data/${PROJ}/${USER}/text2glioma_synth/manifest_release.csv"
# ---------------------------------------------------------------------------

export nnUNet_raw="${NNUNET_ROOT}/nnUNet_raw"
export nnUNet_preprocessed="${NNUNET_ROOT}/nnUNet_preprocessed"
export nnUNet_results="${NNUNET_ROOT}/nnUNet_results"
mkdir -p "$nnUNet_raw" "$nnUNet_preprocessed" "$nnUNet_results"

module load python3/3.11.7
module load cuda/12.4.1
source ~/venvs/nnunet/bin/activate 2>/dev/null || {
    python3 -m venv ~/venvs/nnunet
    source ~/venvs/nnunet/bin/activate
    pip install -q --upgrade pip
    pip install -q nnunetv2 nibabel scipy
}

DATASET_IDS=(510 511 512 513 514)
DID="${DATASET_IDS[$PBS_ARRAY_INDEX]}"

# Rank 0 builds all datasets once (idempotent -- skips if already populated).
if [ "$PBS_ARRAY_INDEX" -eq 0 ] && [ ! -f "${nnUNet_raw}/Dataset510_T2GRealOnly/dataset.json" ]; then
    python3 "${USER_DIR}/scripts/segmentation/build_nnunet_datasets.py" \
        --nnUNet-raw "$nnUNet_raw" \
        --datalist "${USER_DIR}/datalist_N1510.json" \
        --synth-manifest "$SYNTH_MANIFEST" \
        --real-root "$REAL_ROOT" \
        --n-synth 0 500 1000 5000 10000 \
        --seed 42
fi

# Wait for rank 0 if this is a later shard.
while [ ! -f "${nnUNet_raw}/Dataset${DID}_T2G*/dataset.json" ] 2>/dev/null; do
    sleep 30
done

nnUNetv2_plan_and_preprocess -d "$DID" --verify_dataset_integrity
nnUNetv2_train "$DID" 3d_fullres 0 --npz

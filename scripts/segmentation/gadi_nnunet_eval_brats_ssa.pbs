#!/bin/bash
# Predict + evaluate the nine trained nnU-Net models (5 pooled + 4 balanced
# sampler) on the BraTS-2023 SSA (Sub-Saharan Africa) external test cohort.
# Genuine OOD: different scanners, different patient population, same
# preprocessing convention (SRI24-registered, skull-stripped).
#
# Array index dispatch:
#   0..4 -> pooled sampler,   Dataset510..514  (n_synth = 0/500/1000/5000/10000)
#   5..8 -> balanced sampler, Dataset511..514  (n_synth =   500/1000/5000/10000)
#
#     qsub scripts/segmentation/gadi_nnunet_eval_brats_ssa.pbs
#
#PBS -q gpuhopper
#PBS -N t2g_nnunet_ssa
#PBS -P vp06
#PBS -r y
#PBS -J 0-8
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=128GB
#PBS -l walltime=03:00:00
#PBS -l storage=scratch/vp06+gdata/vp06+gdata/hl36
#PBS -l wd
#PBS -j oe
#PBS -l jobfs=250GB

set -euo pipefail

PROJ="vp06"
USER_DIR="$HOME/text2glioma"
NNUNET_ROOT="/g/data/${PROJ}/${USER}/nnUNet"
BRATS_SSA_ROOT="/g/data/${PROJ}/${USER}/text2glioma_train/data/ASNR-MICCAI-BraTS2023-SSA-Challenge-TrainingData_V2"

export nnUNet_raw="${NNUNET_ROOT}/nnUNet_raw"
export nnUNet_preprocessed="${NNUNET_ROOT}/nnUNet_preprocessed"
export nnUNet_results="${NNUNET_ROOT}/nnUNet_results"

module load python3/3.11.7
source /g/data/${PROJ}/${USER}/venvs/nnunet/bin/activate

# Sampler / dataset dispatch from array index.
if [ "$PBS_ARRAY_INDEX" -lt 5 ]; then
    SAMPLER="pooled"
    TRAINER="nnUNetTrainer"
    DATASET_IDS=(510 511 512 513 514)
    N_SYNTH=(0 500 1000 5000 10000)
    LOCAL_IDX="$PBS_ARRAY_INDEX"
    OUT_DIR="${USER_DIR}/paper/tables/nnunet_eval"
else
    SAMPLER="balanced"
    TRAINER="nnUNetTrainerBalancedSynth"
    DATASET_IDS=(511 512 513 514)
    N_SYNTH=(500 1000 5000 10000)
    LOCAL_IDX=$((PBS_ARRAY_INDEX - 5))
    OUT_DIR="${USER_DIR}/paper/tables/nnunet_eval_balanced"
fi
DID="${DATASET_IDS[$LOCAL_IDX]}"
NS="${N_SYNTH[$LOCAL_IDX]}"

DATASET_MATCHES=(${nnUNet_results}/Dataset${DID}_T2G*)
DATASET_DIR="${DATASET_MATCHES[0]}"
TRAINER_DIR="${DATASET_DIR}/${TRAINER}__nnUNetResEncUNetLPlans__3d_fullres"

PRED_DIR="${TRAINER_DIR}/predict_brats_ssa"
STAGED="${nnUNet_results}/staging_brats_ssa"
STAGED_LBL="${nnUNet_results}/staging_brats_ssa_labels"
mkdir -p "$OUT_DIR" "$PRED_DIR"

# Stage once, shared across shards. flock serialises the first-writer race.
mkdir -p "${nnUNet_results}"
(
    flock -x 200
    if [ ! -f "${STAGED}/.done" ]; then
        python3 "${USER_DIR}/scripts/segmentation/stage_test_split.py" \
            --from-brats-dir "${BRATS_SSA_ROOT}" \
            --out-dir "${STAGED}" \
            --out-labels "${STAGED_LBL}"
        touch "${STAGED}/.done"
    fi
) 200> "${nnUNet_results}/brats_ssa_stage.lock"

nnUNetv2_predict \
    -d "$DID" -c 3d_fullres -f 0 \
    -p nnUNetResEncUNetLPlans \
    -tr "$TRAINER" \
    -chk checkpoint_best.pth \
    -i "${STAGED}" -o "${PRED_DIR}" \
    --save_probabilities

python3 "${USER_DIR}/scripts/segmentation/eval_lesion_wise.py" \
    --pred-dir "${PRED_DIR}" \
    --gt-dir "${STAGED_LBL}" \
    --out-csv "${OUT_DIR}/brats_ssa_synth${NS}.csv" \
    --workers 12

#!/bin/bash

#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=256GB
#PBS -l jobfs=50GB
#PBS -q gpuhopper
#PBS -P vp06
#PBS -l walltime=00:20:00
#PBS -l storage=gdata/dk92+scratch/vp06+gdata/vp06+gdata/hl36+scratch/hl36
#PBS -l wd
#PBS -j oe
#PBS -N decoder_prior_probe

# ── Decoder DC-prior probe ─────────────────────────────────────────
# Encodes the first 5 train + 5 val samples, then decodes under four
# latent conditions (zero / training-mean / center-block-zeroed /
# baseline) to test whether the central T2-contrast bright-patch
# artifact is the decoder's intrinsic response at near-zero latents.

# ── Environment ─────────────────────────────────────────────────────
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/23.05
module load python3/3.9.2

source /g/data/hl36/nk9793/venv/monai/bin/activate

# ── Run ─────────────────────────────────────────────────────────────
RUN_DIR=/g/data/vp06/$USER/text2glioma_train/runs/stage1_overfit_memsafe
DATALIST_SRC=${HOME}/text2glioma/datalist_N1510.json
mkdir -p "${HOME}/job_logs"
TMP_DATALIST="${HOME}/job_logs/datalist_first5_probe_${PBS_JOBID}.json"

python - <<PY
import json
from pathlib import Path

src = Path("${DATALIST_SRC}").expanduser()
dst = Path("${TMP_DATALIST}").expanduser()

d = json.loads(src.read_text())
d["training"] = d.get("training", [])[:5]
d["validation"] = d.get("validation", [])[:5]
d["n_training"] = len(d["training"])
d["n_validation"] = len(d["validation"])
d["n_subjs"] = d["n_training"] + d["n_validation"]

dst.write_text(json.dumps(d, indent=2))
print(f"Wrote mini datalist to {dst}")
PY

cd ${HOME}/text2glioma/scripts

python ${HOME}/text2glioma/scripts/decoder_prior_probe.py \
    --run_dir "$RUN_DIR" \
    --datalist "$TMP_DATALIST" \
    --no_channel_reorder \
    --n_samples 5 \
    --center_block 2 \
    --center_frac 0.25 \
    --num_workers 2 \
    2>&1 | tee "${HOME}/job_logs/${PBS_JOBID}_decoder_prior_probe.log"
